# OMS 環境変数サンプル
# このファイルをコピーして .env を作成する（.env は .gitignore 済み）。
#   cp .env.example .env

# ───────────────────────────────────────────────────────────────
# 永続化（Drizzle + Neon Postgres）
# ───────────────────────────────────────────────────────────────
#
# 未設定の場合：アプリは in-memory seed のみで動作する（リロードで状態リセット）。
# dev / e2e はこの状態が既定。snapshot/restore は no-db フォールバックする。
#
# 設定する場合：Neon の接続文字列を入れる（プーリング有効な URL 推奨）。
#   例: postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# ───────────────────────────────────────────────────────────────
# 永続化のセキュリティゲート（fail-closed / secure by default）
# ───────────────────────────────────────────────────────────────
#
# ⚠ snapshot/restore は "use server" により未認証で外部公開される server action。
#   認証ライブラリが未導入の現状で DATABASE_URL を設定すると、全業務データが
#   未認証で読み書き可能になる。事故防止のため、実 DB への読み書きには
#   このフラグの明示的オプトインを必須にしている。
#
#   - 未設定 / "1" 以外           → 実 DB があっても永続化を拒否（forbidden、in-memory のまま）
#   - "1"                         → 永続化を許可
#
#   "1" にしてよいのは「アプリ全体が既にログイン/ゲートウェイ（例: Vercel の
#   アクセス保護）の背後にあり、かつシングルテナント運用」の場合のみ。
#   公開・マルチテナント運用前には per-user 認証 + セッション由来 workspace が別途必須。
#   参照: reference_security_audit_v1
OMS_PERSIST_ALLOW_UNAUTHENTICATED=

# テナント分離キー（workspace）。未設定なら "default"。
# シングルテナント運用では空のままでよい。将来マルチテナント化する際は
# resolveWorkspace() をセッション由来に差し替える（ここは暫定の固定値）。
OMS_WORKSPACE=
